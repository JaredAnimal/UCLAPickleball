{
  "name": "ucla-club-pickleball",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:calendar": "node scripts/validate-pickleball.mjs",
    "test:runtime": "node scripts/validate-runtime.mjs",
    "check": "pnpm typecheck && pnpm test:calendar && pnpm build && pnpm test:runtime",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
