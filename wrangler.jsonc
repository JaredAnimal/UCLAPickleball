// Production settings database; member names and Sheet credentials stay outside this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uclapickleball",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ucla-club-pickleball",
      "database_id": "d54799f5-2125-4065-8e6f-03b3b0f4334f",
      "migrations_dir": "migrations"
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.zip"
      ],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": [
        "**/*.gs"
      ],
      "fallthrough": true
    }
  ],
  "previews": {
    "vars": {
      "PREVIEW_READ_ONLY": "true",
      "PREVIEW_WORKER_NAME": "uclapickleball"
    },
    "version_metadata": {
      "binding": "CF_VERSION_METADATA"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ucla-club-pickleball-preview",
        "database_id": "9f66e353-e518-4deb-8fb9-1586a6e2f2be",
        "migrations_dir": "migrations"
      }
    ]
  }
}
